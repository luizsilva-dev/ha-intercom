#!/command/with-contenv bashio
export HA_TOKEN="${SUPERVISOR_TOKEN}"
export HA_URL="http://supervisor/core"
export GO2RTC_URL="http://localhost:1984"
export CALL_TIMEOUT="$(bashio::config 'call_timeout')"
export MAX_CALL_DURATION="$(bashio::config 'max_call_duration')"
export LOG_LEVEL="$(bashio::config 'log_level')"
export OPTIONS_PATH="/data/options.json"

bashio::log.info "Starting intercom API..."
exec python3 /app/main.py
